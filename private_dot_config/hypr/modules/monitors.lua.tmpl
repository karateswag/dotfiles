-- ~/.config/hypr/modules/monitors.lua

-- See https://wiki.hypr.land/Configuring/Basics/Monitors/

{{- if eq .chezmoi.hostname "arch-desktop" }}
hl.monitor({
  output = "DP-1",
  mode = "highrr",
  position = "auto-center-right",
  scale = 1.25,
  vrr = 1,
  bitdepth = 10,
  cm = "hdr",
  sdrbrightness = 1.3,
})
hl.monitor({
  output = "DP-2",
  mode = "highrr",
  position = "auto-center-right",
  scale = 1.25,
  vrr = 1,
})
{{- else if eq .chezmoi.hostname "arch-xps" }}
hl.monitor({
	output = "eDP-1",
	mode = "preferred",
	position = "auto-center-right",
	scale = 1.2,
})

hl.monitor({
	output = "",
	mode = "preferred",
	position = "auto-center-right",
	scale = "auto",
})
{{- else }}
hl.monitor({
	output = "",
	mode = "preferred",
	position = "auto-center-right",
	scale = "auto",
})
{{- end }}
